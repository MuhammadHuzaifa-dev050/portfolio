---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import CurrentWork from '../../components/CurrentWork.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.id || project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);

const { title, image, tags, shortDescription } = project.data;
---

<Layout title={`${title} | Case Study`}>
	<Header isProjectPage={true} />
	
	<main class="w-full">
    <!-- Hero Section for Project -->
    <section class="w-full pt-32 pb-16 relative overflow-hidden">
      <div class="max-w-6xl mx-auto px-6 relative z-10">
        <div class="flex flex-col gap-4 mb-8">
          <div class="flex items-center gap-2 text-cyan-accent text-xs font-bold tracking-[0.2em] uppercase">
            <a href="/" class="hover:text-white transition-colors duration-300">Home</a>
            <span>/</span>
            <span>Project Case Study</span>
          </div>
          <h1 class="text-4xl md:text-6xl font-heading font-extrabold text-white leading-tight">
            {title}
          </h1>
          <p class="text-lg md:text-xl text-text-muted max-w-3xl leading-relaxed mb-6">
            {shortDescription}
          </p>
          
          <!-- Section Jump Links -->
          {headings && headings.length > 0 && (
            <div class="flex flex-wrap gap-3 mt-4">
              {headings.filter(h => h.depth === 2).map((heading) => (
                <a 
                  href={`#${heading.slug}`}
                  class="text-[11px] font-bold text-text-muted hover:text-cyan-accent border border-white/10 hover:border-cyan-accent/50 rounded-full px-4 py-2 tracking-widest uppercase transition-all duration-300 bg-white/5 backdrop-blur-sm"
                >
                  {heading.text}
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
      
      <!-- Background Decorative Element -->
      <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-cyan-accent/5 to-transparent -z-10"></div>
    </section>

		<!-- Master Two-Column Sticky Layout -->
		<div class="relative w-full max-w-6xl mx-auto px-6 pb-24 flex flex-col md:flex-row gap-8 z-10">
			<!-- STICKY LEFT COLUMN (Feature Card) -->
			<div class="hidden md:block md:w-1/3 relative">
				<div class="sticky top-10 h-screen flex flex-col justify-center pb-16">
          <div class="mb-8">
            <h3 class="text-xs font-bold text-white tracking-widest uppercase mb-4 flex items-center gap-2">
              <span class="text-cyan-accent">•</span> SKILLS
            </h3>
            <div class="flex flex-wrap gap-2">
              {tags.map(tag => (
                <span class="text-[10px] font-bold text-cyan-accent border border-cyan-accent/40 rounded-md px-3 py-1 tracking-wider uppercase bg-cyan-accent/5">
                  {tag}
                </span>
              ))}
            </div>
          </div>
					<CurrentWork />
				</div>
			</div>

			<!-- RIGHT CONTENT (Case Study Content) -->
			<div class="w-full md:w-2/3 flex flex-col">
        <!-- Main Project Image -->
        <div class="w-full aspect-video rounded-2xl overflow-hidden border border-white/5 mb-8 shadow-2xl relative group">
          <div class="absolute inset-0 bg-cyan-accent/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <img src={image} alt={title} class="w-full h-full object-cover" />
          <div class="absolute bottom-0 left-0 right-0 h-1 bg-cyan-accent"></div>
        </div>

        <!-- Markdown Content -->
        <article class="markdown-content max-w-none">
          <Content />
        </article>

        <!-- Footer Action -->
        <div class="mt-24 pt-12 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-8">
          <div class="flex flex-col gap-2">
            <h4 class="text-white font-bold text-xl">Intrigued by the engineering?</h4>
            <p class="text-text-muted">Let's discuss how I can bring this level of dedication to your project.</p>
          </div>
          <a href="#contact" class="w-full md:w-auto shrink-0 px-8 py-4 bg-cyan-accent text-[#0b1219] rounded-lg font-bold text-center hover:bg-white transition-all duration-300 tracking-widest uppercase shadow-xl whitespace-nowrap">
            GET IN TOUCH
          </a>
        </div>
			</div>
		</div>
	</main>

  <!-- Full-Screen Lightbox Overlay -->
  <div id="image-lightbox" class="fixed inset-0 bg-[#09090b]/95 backdrop-blur-md z-50 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-500">
    <div class="absolute top-8 right-8 text-white/40 hover:text-cyan-accent cursor-pointer text-5xl transition-colors" id="lightbox-close">&times;</div>
    <img id="lightbox-img" src="" alt="Full Screen" class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg shadow-2xl scale-95 transition-transform duration-500" />
  </div>

</Layout>

<script>
  // Elements
  const images = document.querySelectorAll('.markdown-content img');
  const lightbox = document.getElementById('image-lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const lightboxClose = document.getElementById('lightbox-close');

  // Dynamically Wrap Images & Inject Eye Containers
  images.forEach(img => {
    // Create Wrapper
    const wrapper = document.createElement('div');
    wrapper.className = 'relative inline-block w-full group cursor-pointer my-16'; // Reduced margin to tighten space to surrounding text
    
    // Ensure Image spans full space gracefully
    img.className += " relative z-0";
    if (img.parentNode) {
      img.parentNode.insertBefore(wrapper, img);
      wrapper.appendChild(img);
    }

    // Clean up image's native margins since wrapper now handles spacing
    img.style.marginTop = '0';
    img.style.marginBottom = '0';

    // Inject "Theme Shade" Overlay
    const shade = document.createElement('div');
    shade.className = 'absolute inset-0 bg-[#09090b]/70 mix-blend-multiply opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 pointer-events-none border-2 border-transparent group-hover:border-cyan-accent/30 rounded-xl';
    wrapper.appendChild(shade);

    // Inject Robotic SVG HUD Eye into Wrapper
    const eyeContainer = document.createElement('div');
    eyeContainer.className = 'absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-40 h-20 pointer-events-none opacity-0 scale-50 transition-all duration-500 group-hover:opacity-100 group-hover:scale-100 flex items-center justify-center z-20';
    
    // Custom SVG path for a Sleek Futuristic Robotic Eye (Flattened Hexagon / Cyber-Almond)
    eyeContainer.innerHTML = `
      <svg viewBox="0 0 120 60" class="absolute w-full h-full text-cyan-accent drop-shadow-[0_0_12px_rgba(0,255,255,0.6)]">
        <!-- Main Metallic Eyelid (Faceted Hexagon) -->
        <polygon points="0,30 30,5 90,5 120,30 90,55 30,55" fill="rgba(6,10,14,0.95)" stroke="currentColor" stroke-width="2"/>
        <!-- Secondary Inner Mechanism -->
        <polygon points="12,30 36,12 84,12 108,30 84,48 36,48" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2 3" opacity="0.7"/>
        <!-- Cybernetic Wireframe & Shutter Lines -->
        <line x1="30" y1="5" x2="30" y2="55" stroke="rgba(0,255,255,0.2)" stroke-width="1.5"/>
        <line x1="90" y1="5" x2="90" y2="55" stroke="rgba(0,255,255,0.2)" stroke-width="1.5"/>
        <line x1="0" y1="30" x2="120" y2="30" stroke="rgba(0,255,255,0.15)" stroke-width="1"/>
      </svg>
      <!-- Robotic Optic Pupil -->
      <div class="eye-pupil w-8 h-8 rounded-full border-2 border-cyan-accent bg-[#0b1219] flex items-center justify-center relative transition-[transform] duration-[50ms] ease-out z-10 shadow-[0_0_20px_rgba(0,255,255,0.9)]">
        <div class="w-2.5 h-2.5 bg-white rounded-full shadow-[0_0_10px_#fff]"></div>
        <div class="absolute w-6 h-6 border border-cyan-accent rounded-full opacity-50"></div>
      </div>
    `;
    wrapper.appendChild(eyeContainer);

    const pupil = eyeContainer.querySelector('.eye-pupil') as HTMLElement;

    // Pupil Tracking Math based ONLY on this specific container's bounds
    wrapper.addEventListener('mousemove', (e) => {
      const rect = wrapper.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;
      
      const dx = e.clientX - centerX;
      const dy = e.clientY - centerY;
      const angle = Math.atan2(dy, dx);
      
      // Calculate dynamic distance perfectly mapped to the new flattened hexagon eye slit
      const distanceX = Math.min(Math.abs(dx * 0.08), 34); 
      const distanceY = Math.min(Math.abs(dy * 0.08), 8); // Tightly clamped Y constraint so it doesn't break out of the slit

      const pupilX = Math.cos(angle) * distanceX;
      const pupilY = Math.sin(angle) * distanceY;
      
      if(pupil) {
        pupil.style.transform = `translate(${pupilX}px, ${pupilY}px)`;
      }
    });

    wrapper.addEventListener('mouseleave', () => {
      if(pupil) {
        pupil.style.transform = `translate(0px, 0px)`;
      }
    });

    // Lightbox Logic attached to wrapper
    wrapper.addEventListener('click', () => {
      if(lightbox && lightboxImg && img instanceof HTMLImageElement) {
        lightboxImg.src = img.src;
        lightbox.classList.add('opacity-100', 'pointer-events-auto');
        lightbox.classList.remove('opacity-0', 'pointer-events-none');
        setTimeout(() => lightboxImg.classList.replace('scale-95', 'scale-100'), 10);
      }
    });
  });

  // Lightbox Close Logic
  const closeLightbox = () => {
    if(lightbox && lightboxImg) {
      lightbox.classList.remove('opacity-100', 'pointer-events-auto');
      lightbox.classList.add('opacity-0', 'pointer-events-none');
      lightboxImg.classList.replace('scale-100', 'scale-95');
    }
  };
  
  if(lightbox) lightbox.addEventListener('click', closeLightbox);
  if(lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
</script>

<style is:global>
  /* Explicit styling for Markdown Content since Typography plugin is absent */
  .markdown-content h2 {
    font-family: var(--font-heading);
    font-size: 2.5rem; /* 4xl/5xl */
    font-weight: 800; /* extrabold */
    color: white;
    margin-top: 6rem;
    margin-bottom: 2.5rem;
    padding-left: 1.25rem;
    border-left: 4px solid var(--color-cyan-accent);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    scroll-margin-top: 8rem;
  }
  
  .markdown-content h2:first-child {
    margin-top: 1rem;
  }
  
  .markdown-content p {
    color: var(--color-text-muted);
    font-size: 1.25rem; /* xl */
    line-height: 1.6; /* very relaxed */
    margin-bottom: 2rem;
  }

  .markdown-content img {
    width: 100%;
    max-width: 100%;
    max-height: 65vh; /* Prevents image from stretching taller than the screen */
    object-fit: cover;
    display: block;
    margin-left: auto !important;
    margin-right: auto !important;
    border-radius: 0.75rem; /* rounded-xl */
    border: 1px solid rgba(255, 255, 255, 0.1); /* border-white/10 */
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    transition: transform 0.4s ease, border-color 0.4s ease;
  }
  
  .markdown-content .group:hover img {
    transform: scale(1.02);
    border-color: rgba(0, 255, 255, 0.5); /* Subtle cyan glow on hover */
  }

  .markdown-content strong {
    color: white;
    font-weight: 700;
    background-color: rgba(255, 255, 255, 0.05); /* bg-white/5 */
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
  }

  .markdown-content ul {
    margin-top: 2rem;
    margin-bottom: 2rem;
    list-style-type: disc;
    padding-left: 1.5rem;
  }

  .markdown-content li {
    color: var(--color-text-muted);
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
  }

  /* Responsive styling for the feature card on mobile */
  @media (max-width: 767px) {
    .sticky {
      position: relative !important;
      top: 0 !important;
    }
  }
</style>
