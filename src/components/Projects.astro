---
// Projects.astro
const projects = [
  {
    title: 'Website - Game of Thrones',
    description: 'A project created with Astro aiming to demonstrate abilities. High focus on performance and SEO.',
    tags: ['JAVASCRIPT', 'HTML', 'CSS', 'RESPONSIVE DESIGN', 'SEO / AEO'],
    image: 'https://images.unsplash.com/photo-1550745165-9bc0b252726f?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80',
    link: '#'
  },
  {
    title: 'Website - Insurance Broker',
    description: 'A website for presenting plans and coverages focused on an insurance agency.',
    tags: ['REACT', 'TAILWIND', 'VITE', 'UX/UI'],
    image: 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80',
    link: '#'
  }
];
---
<section id="projects" class="w-full pt-16 pb-8 z-10 relative">
      <h3 class="text-sm font-bold text-white tracking-widest uppercase mb-8 flex items-center gap-2">
        <span class="text-cyan-accent text-lg">&lt;/&gt;</span> PROJECTS
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {projects.map((project) => (
          <div class="bg-dark-surface rounded-xl overflow-hidden shadow-lg border border-white/5 hover:border-cyan-accent/30 transition-colors duration-300 flex flex-col group">
            
            <div class="h-40 overflow-hidden relative">
              <div class="absolute inset-0 bg-cyan-accent/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10 pointer-events-none mix-blend-overlay"></div>
              <img src={project.image} alt={project.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <!-- Top accent bar -->
              <div class="absolute top-0 left-0 right-0 h-1 bg-cyan-accent z-20"></div>
            </div>
            
            <div class="p-6 flex flex-col flex-grow">
              <h4 class="font-heading font-semibold text-white text-lg mb-2">{project.title}</h4>
              <p class="text-text-muted text-sm mb-6 leading-relaxed flex-grow">{project.description}</p>
              
              <div class="flex flex-wrap gap-2 mb-6">
                {project.tags.map(tag => (
                  <span class="text-[9px] font-bold text-cyan-accent border border-cyan-accent/40 rounded-full px-2 py-1 tracking-wider uppercase bg-cyan-accent/5">
                    {tag}
                  </span>
                ))}
              </div>
              
              <a href={project.link} class="w-full py-3 bg-[#171f2c] border border-white/10 rounded-md text-center text-xs font-bold text-cyan-accent hover:bg-cyan-accent hover:text-[#0b1219] transition-all duration-300 tracking-widest">
                VISIT SITE
              </a>
            </div>
            
          </div>
        ))}
</section>
