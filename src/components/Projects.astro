---
// Projects.astro
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
---

<section id="projects" class="w-full pt-16 pb-8 z-10 relative">
  <h3 class="text-sm font-bold text-white tracking-widest uppercase mb-8 flex items-center gap-2">
    <span class="text-cyan-accent text-lg">&lt;/&gt;</span> PROJECTS
  </h3>

  <div class="relative group/slider overflow-hidden" id="project-slider">
    <!-- Slider Track -->
    <div 
      id="slider-track"
      class="flex transition-transform duration-700 ease-in-out gap-6"
      style="transform: translateX(0);"
    >
      {projects.map((project) => (
        <div class="project-card h-[435px] min-w-full md:min-w-[calc(50%-12px)] bg-dark-surface rounded-xl overflow-hidden shadow-lg border border-white/5 hover:border-cyan-accent/30 transition-all duration-500 flex flex-col group relative">
          
          <div class="h-40 shrink-0 overflow-hidden relative">
            <div class="absolute inset-0 bg-cyan-accent/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10 pointer-events-none mix-blend-overlay"></div>
            <img src={project.data.image} alt={project.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <!-- Top accent bar -->
            <div class="absolute top-0 left-0 right-0 h-1 bg-cyan-accent z-20"></div>
          </div>
          
          <div class="p-6 flex flex-col flex-grow">
            <h4 class="font-heading font-semibold text-white text-lg mb-2">{project.data.title}</h4>
            <p class="text-text-muted text-sm mb-4 leading-relaxed flex-grow line-clamp-2 overflow-hidden text-ellipsis">
              {project.data.shortDescription}.....
            </p>
            
            <div class="hidden flex-wrap gap-2 mb-8">
              {project.data.tags.map(tag => (
                <span class="text-[9px] font-bold text-cyan-accent border border-cyan-accent/40 rounded-full px-2 py-1 tracking-wider uppercase bg-cyan-accent/5">
                  {tag}
                </span>
              ))}
            </div>
            
            <div class="flex gap-3">
              <a 
                href={`/projects/${project.id || project.slug}`} 
                target="_blank"
                class="flex-1 py-3 bg-cyan-accent text-[#0b1219] rounded-md text-center text-[10px] font-bold hover:bg-white transition-all duration-300 tracking-widest uppercase shadow-[0_0_15px_rgba(255,69,0,0.3)]"
              >
                View Full Case-Study
              </a>
              {project.data.link && project.data.link !== '#' && (
                <a 
                  href={project.data.link}
                  target="_blank"
                  class="px-4 py-3 bg-[#171f2c] border border-white/10 rounded-md text-center text-[10px] font-bold text-white hover:border-cyan-accent transition-all duration-300 flex items-center justify-center"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Navigation Arrows -->
    {projects.length > 2 && (
      <>
        <button 
          id="prev-btn"
          class="hidden md:flex absolute left-2 top-1/2 -translate-y-1/2 z-30 text-white items-center justify-center transition-all duration-500 hover:text-cyan-accent hover:scale-110 p-2 drop-shadow-[0_4px_8px_rgba(0,0,0,0.8)]"
          aria-label="Previous Projects"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button 
          id="next-btn"
          class="hidden md:flex absolute right-2 top-1/2 -translate-y-1/2 z-30 text-white items-center justify-center transition-all duration-500 hover:text-cyan-accent hover:scale-110 p-2 drop-shadow-[0_4px_8px_rgba(0,0,0,0.8)]"
          aria-label="Next Projects"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </>
    )}
  </div>

  <!-- Carousel Dots -->
  <div id="slider-dots" class="flex justify-center items-center gap-3 mt-8 z-20 relative"></div>
</section>

<script>
  function setupSlider() {
    const track = document.getElementById('slider-track');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const cards = document.querySelectorAll('.project-card');
    const dotsContainer = document.getElementById('slider-dots');

    let currentIndex = 0;
    const totalCards = cards.length;

    function updateSlider() {
      const isMobile = window.innerWidth < 768;
      const cardsVisible = isMobile ? 1 : 2;
      const maxIndex = totalCards - cardsVisible;
      
      if (currentIndex > maxIndex) currentIndex = maxIndex;
      if (currentIndex < 0) currentIndex = 0;

      // Calculate translation
      let translateX = 0;
      if (isMobile) {
        translateX = -(currentIndex * 100);
      } else {
        // Desktop: 50% width minus half of gap (12px)
        translateX = -(currentIndex * (50 + (12 / track.clientWidth * 100)));
      }

      // Special case for desktop 2nd slide:
      // If we have 3 projects, currentIndex 0 shows 1&2, currentIndex 1 shows 2&3.
      // Gap is 24px (gap-6). Each card is calc(50% - 12px).
      // Total width = 50% - 12px + 24px + 50% - 12px = 100%. Correct.
      
      const gap = 24; // gap-6 is 1.5rem = 24px
      const cardWidth = isMobile ? track.clientWidth : (track.clientWidth - gap) / 2;
      const moveDistance = currentIndex * (cardWidth + gap);
      
      track.style.transform = `translateX(-${moveDistance}px)`;

      // Update button visibility/state
      if (prevBtn) prevBtn.style.visibility = currentIndex === 0 ? 'hidden' : 'visible';
      if (nextBtn) nextBtn.style.visibility = currentIndex >= maxIndex ? 'hidden' : 'visible';

      // Update dots
      if (dotsContainer) {
        const numDots = maxIndex + 1;
        if (dotsContainer.children.length !== numDots) {
          dotsContainer.innerHTML = '';
          for (let i = 0; i < numDots; i++) {
            const dot = document.createElement('button');
            dot.className = `h-2 md:h-2.5 rounded-full transition-all duration-300 ${i === currentIndex ? 'bg-cyan-accent w-6 md:w-8' : 'bg-white/20 hover:bg-white/50 w-2 md:w-2.5'}`;
            dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
            dot.addEventListener('click', () => {
              currentIndex = i;
              updateSlider();
            });
            dotsContainer.appendChild(dot);
          }
        } else {
          Array.from(dotsContainer.children).forEach((dot, i) => {
            dot.className = `h-2 md:h-2.5 rounded-full transition-all duration-300 ${i === currentIndex ? 'bg-cyan-accent w-6 md:w-8' : 'bg-white/20 hover:bg-white/50 w-2 md:w-2.5'}`;
          });
        }
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        currentIndex--;
        updateSlider();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        currentIndex++;
        updateSlider();
      });
    }

    window.addEventListener('resize', updateSlider);
    updateSlider(); // Initial setup

    // Touch Swipe Support
    let touchStartX = 0;
    let touchMoveX = 0;
    let isDragging = false;
    let startTranslate = 0;

    function getTranslateX() {
      const style = window.getComputedStyle(track);
      const matrix = new WebKitCSSMatrix(style.transform);
      return matrix.m41;
    }

    track.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
      startTranslate = getTranslateX();
      isDragging = true;
      track.style.transition = 'none';
    }, { passive: true });

    track.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      touchMoveX = e.touches[0].clientX;
      const diff = touchMoveX - touchStartX;
      
      // Add resistance at bounds
      const maxMove = -( (totalCards - (window.innerWidth < 768 ? 1 : 2)) * (track.clientWidth / (window.innerWidth < 768 ? 1 : 2)) );
      let newTranslate = startTranslate + diff;
      
      if (newTranslate > 0) newTranslate = diff / 3;
      if (newTranslate < maxMove) newTranslate = maxMove + (diff / 3);

      track.style.transform = `translateX(${newTranslate}px)`;
    }, { passive: true });

    track.addEventListener('touchend', (e) => {
      if (!isDragging) return;
      isDragging = false;
      track.style.transition = 'transform 0.5s ease-out';
      
      const diff = touchMoveX - touchStartX;
      const threshold = 50; // pixels to trigger slide

      if (Math.abs(diff) > threshold) {
        if (diff > 0 && currentIndex > 0) {
          currentIndex--;
        } else if (diff < 0) {
          const isMobile = window.innerWidth < 768;
          const maxIndex = totalCards - (isMobile ? 1 : 2);
          if (currentIndex < maxIndex) {
            currentIndex++;
          }
        }
      }
      
      updateSlider();
    });
  }

  // Support for Astro view transitions
  document.addEventListener('astro:page-load', setupSlider);
  // Initial run
  setupSlider();
</script>

<style>
  .project-card {
    /* Ensure hardware acceleration for smoother transitions */
    will-change: transform, opacity;
  }
  
  #slider-track {
    will-change: transform;
  }

  /* Fade effect logic if needed - currently using transform for sliding */
</style>
