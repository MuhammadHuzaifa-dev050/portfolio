---
// Contact.astro
---
<section id="contact" class="w-full pt-16 pb-16 z-10 relative mb-16 border-t border-white/5">
  <div class="flex flex-col lg:flex-row gap-16 lg:gap-8">
    
    <!-- Left Column: Contact Information -->
    <div class="w-full lg:w-5/12 flex flex-col justify-center">
      <h3 class="text-sm font-bold text-white tracking-widest uppercase mb-8 flex items-center gap-2">
        <span class="text-cyan-accent text-lg">&lt;/&gt;</span> CONTACT
      </h3>

      <h2 class="text-4xl font-heading font-bold text-white mb-6 leading-tight">
        Let's build something <span class="text-cyan-accent">extraordinary.</span>
      </h2>

      <p class="text-text-muted mb-12 leading-relaxed text-lg">
        Feel free to reach out. Whether you have a question, a project idea, or just want to connect, I am available every day for inquiries.
      </p>
    </div>

    <!-- Right Column: Contact Form -->
    <div class="w-full lg:w-7/12">
      <!-- 
        IMPORTANT: Paste your FormsPree URL in the 'action' attribute below.
        e.g., action="https://formspree.io/f/xabcdefg"
      -->
      <form 
        action="https://formspree.io/f/YOUR_ENDPOINT_HERE" 
        method="POST"
        class="bg-dark-surface p-8 rounded-2xl border border-white/10 shadow-2xl flex flex-col gap-6"
      >
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Name -->
          <div class="flex flex-col gap-2">
            <label for="name" class="text-xs font-bold text-text-muted tracking-widest uppercase">Name</label>
            <input 
              type="text" 
              name="name" 
              id="name" 
              required
              placeholder="John Doe"
              class="w-full bg-[#111822] border border-white/5 rounded-lg px-4 py-3 text-white placeholder-text-muted/50 focus:outline-none focus:border-cyan-accent/50 focus:ring-1 focus:ring-cyan-accent/50 transition-all duration-300"
            />
          </div>
          <!-- Email -->
          <div class="flex flex-col gap-2">
            <label for="email" class="text-xs font-bold text-text-muted tracking-widest uppercase">Email</label>
            <input 
              type="email" 
              name="email" 
              id="email" 
              required
              placeholder="john@example.com"
              class="w-full bg-[#111822] border border-white/5 rounded-lg px-4 py-3 text-white placeholder-text-muted/50 focus:outline-none focus:border-cyan-accent/50 focus:ring-1 focus:ring-cyan-accent/50 transition-all duration-300"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Company Name -->
          <div class="flex flex-col gap-2">
            <label for="company" class="text-xs font-bold text-text-muted tracking-widest uppercase">Company Name</label>
            <input 
              type="text" 
              name="company" 
              id="company" 
              placeholder="Acme Corp"
              class="w-full bg-[#111822] border border-white/5 rounded-lg px-4 py-3 text-white placeholder-text-muted/50 focus:outline-none focus:border-cyan-accent/50 focus:ring-1 focus:ring-cyan-accent/50 transition-all duration-300"
            />
          </div>
          <!-- Designation -->
          <div class="flex flex-col gap-2">
            <label for="designation" class="text-xs font-bold text-text-muted tracking-widest uppercase">Designation</label>
            <input 
              type="text" 
              name="designation" 
              id="designation" 
              placeholder="CEO / Project Manager"
              class="w-full bg-[#111822] border border-white/5 rounded-lg px-4 py-3 text-white placeholder-text-muted/50 focus:outline-none focus:border-cyan-accent/50 focus:ring-1 focus:ring-cyan-accent/50 transition-all duration-300"
            />
          </div>
        </div>

        <!-- Query Box -->
        <div class="flex flex-col gap-2">
          <label for="query" class="text-xs font-bold text-text-muted tracking-widest uppercase">Your Query</label>
          <textarea 
            name="query" 
            id="query" 
            rows="5" 
            required
            placeholder="Tell me about your project, goals, or what you need help with..."
            class="w-full bg-[#111822] border border-white/5 rounded-lg px-4 py-3 text-white placeholder-text-muted/50 resize-y focus:outline-none focus:border-cyan-accent/50 focus:ring-1 focus:ring-cyan-accent/50 transition-all duration-300"
          ></textarea>
        </div>

        <!-- Submit Button -->
        <button 
          type="submit"
          class="w-full py-4 mt-2 bg-cyan-accent text-[#0b1219] rounded-lg font-bold tracking-widest uppercase hover:bg-white hover:text-[#0b1219] transition-all duration-300 shadow-[0_0_20px_rgba(255,69,0,0.2)] hover:shadow-[0_0_30px_rgba(255,69,0,0.4)]"
        >
          Send Message
        </button>
      </form>
    </div>

  </div>
</section>
