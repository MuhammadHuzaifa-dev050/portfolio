---
// Education.astro
const educations = [
  {
    degree: "BS Computer Science (BSCS)",
    institution: "Bahria University",
    year: "2024 - Present"
  }
];
---
<section id="education" class="w-full pt-16 pb-12 z-10 relative">
      <h3 class="text-sm font-bold text-white tracking-widest uppercase mb-8 flex items-center gap-2">
        <span class="text-cyan-accent text-lg">&lt;/&gt;</span> EDUCATION & CERTIFICATIONS
      </h3>
      <div class="space-y-6">
        {educations.map((edu) => (
          <div class="flex flex-col md:flex-row md:items-center justify-between p-5 bg-dark-surface rounded border border-white/5 text-center md:text-left gap-4">
            <div>
              <h4 class="text-white font-heading font-semibold text-lg">{edu.degree}</h4>
              <p class="text-cyan-accent text-sm mt-1">{edu.institution}</p>
            </div>
            <div class="text-text-muted text-sm font-medium">
              {edu.year}
            </div>
          </div>
        ))}
      </div>
    </section>
