---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/terminal-favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title || 'Portfolio | Muhammad Huzaifa'}</title>
    
    <!-- Google Fonts for the confident, sharp theme -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="preload" as="image" href="/hero-image.png" fetchpriority="high" />
	</head>
	<body class="relative min-h-screen bg-dark-bg text-text-muted font-body overflow-x-hidden antialiased">
    <!-- Critical Thinker Grid Pattern -->
    <div class="bg-grid"></div>

		<slot />
    <Footer />
	</body>
</html>
